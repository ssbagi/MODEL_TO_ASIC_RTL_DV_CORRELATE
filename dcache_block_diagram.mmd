%% Direct-Mapped Cache RTL Block Diagram (Corrected)
%% Clean, ASIC-style, with proper signal flow and hierarchy

flowchart LR
  %% Styles
  style CPU fill:#ffffff,stroke:#0b3d91,stroke-width:2px
  style CACHE fill:#eef3ff,stroke:#0b3d91,stroke-width:2px
  style MEM fill:#ffffff,stroke:#0b3d91,stroke-width:2px
  style ADDR fill:#f7f9ff,stroke:#0b3d91,stroke-width:1.5px
  style LINE fill:#ffffff,stroke:#0b3d91,stroke-width:1.5px

  %% CPU Interface
  CPU[CPU Interface<br/>Inputs: req_valid, req_addr[31:0], req_wdata[127:0], req_we<br/>Outputs: req_ready, resp_valid, resp_rdata[127:0], resp_hit]

  %% Cache Block
  subgraph CACHE[Direct-Mapped Cache]
    direction TB
    REQ[Request Frontend<br/>Latch req_valid/addr/we/wdata]
    TAG[Tag RAM + Comparator<br/>Index → Tag → Compare]
    DATA[Data RAM<br/>128-bit cache line]
    META[Valid/Dirty RAM<br/>1-bit valid, 1-bit dirty per line]
    CTRL[Cache FSM<br/>IDLE / MISS / REFILL / WRITEBACK]
  end

  %% Address + Line Format (Reference Only)
  ADDR[Address Breakdown<br/>Tag(22) / Index(6) / Offset(4)]
  LINE[Cache Line Format<br/>Valid | Tag | 128-bit Data | Dirty]

  %% Memory Interface
  MEM[Memory Interface<br/>Outputs: mem_req_valid, mem_req_addr[31:0], mem_req_we, mem_req_wdata[127:0]<br/>Inputs: mem_resp_valid, mem_resp_rdata[127:0]]

  %% CPU → Cache
  CPU -->|req_valid / req_addr / req_wdata / req_we| REQ

  %% REQ → internal RAMs
  REQ -->|index| TAG
  REQ -->|index| DATA
  REQ -->|index| META

  %% Internal datapath
  TAG -->|hit / miss| CTRL
  META -->|valid / dirty| CTRL
  DATA -->|read line| CTRL

  %% Cache → CPU
  CTRL -->|resp_valid / resp_rdata / resp_hit| CPU
  CTRL -->|req_ready| CPU

  %% Cache → Memory
  CTRL -->|mem_req_valid / mem_req_addr / mem_req_we / mem_req_wdata| MEM

  %% Memory → Cache
  MEM -->|mem_resp_valid / mem_resp_rdata| CTRL

  %% Updates on refill / writeback
  CTRL -->|writeback / refill write| DATA
  CTRL -->|tag update| TAG
  CTRL -->|valid/dirty update| META

  %% Reference-only connections
  CPU --- ADDR
  ADDR --- LINE
  LINE --- DATA

  classDef cluster fill:#eef3ff,stroke:#0b3d91,stroke-width:2px;
